/design/
datasets/

# === gitignore hygiene (added 2026-08-27) ===
# Appended automatically. Existing rules above are untouched.
# --- secrets & credentials (never commit) ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.key
!**/*.public.key
*_token
*secret*
!*secrets/
!*secret/
*Secret*
*SECRET*
credentials.json
credentials.yml
credentials.yaml
*.credentials
*-credentials.json
.npmrc
.pypirc
.netrc
id_rsa
id_ed25519
*.der
service-account*.json
gha-creds-*.json

# ...but never hide real source files whose name merely contains a secret-ish word
!*.go
!*.ts
!*.tsx
!*.js
!*.jsx
!*.mjs
!*.cjs
!*.py
!*.rs
!*.rb
!*.java
!*.kt
!*.swift
!*.c
!*.h
!*.cc
!*.cpp
!*.hpp
!*.cs
!*.php
!*.md
!*.sql
!*.tf
!*.sh
!*.vue
!*.svelte
!*.erb
!*.snap

