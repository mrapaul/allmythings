.docker-data/

# Scratch debug files — never checked in
/result.json
/final_*.json
/verify_result.json
/detection_result.json
/automated_result.json
/all_detections.log
/api_latest.log

# Process manager + smoke runs
/tmp/allmythings/
*.pid

# Python cache
__pycache__/
*.pyc

# Python virtualenvs (per-service)
venv/
.venv/
*.egg-info/

# Detection service logs (structured logs go to Loki now)
detection-service/detection*.log

# Node
node_modules/
.DS_Store

# IDE + generated reports
.idea/
coverage-report/
eval/runs/

# Model weights — never in git
*.pt
*.onnx
*.mlpackage

# Env — ignored in every directory, examples allowed
.env
.env.local
!.env.example

# Reference material (design folder is local-only — contains 200+ MB binaries)
/design/
datasets/
