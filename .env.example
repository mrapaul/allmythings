# Environment Configuration Template
# Copy this file to .env and fill in actual values

# Server Configuration
NODE_ENV=development
PORT=3000
API_PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visual_inventory
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# S3 / Storage Configuration
S3_BASE_URL=https://storage.example.com
S3_BUCKET=inventory-photos
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MinIO Configuration (for development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Google Cloud Vision Configuration
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# AWS Rekognition Configuration
AWS_REGION=us-east-1

# Ensemble Configuration
ENSEMBLE_CONFIDENCE_THRESHOLD=0.7
PROVIDER_TIMEOUT_MS=4000
NMS_IOU_THRESHOLD=0.5

# Provider Weights
META_WEIGHT=0.30
GOOGLE_WEIGHT=0.30
AWS_WEIGHT=0.25
TENSORFLOW_WEIGHT=0.15

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_MOCK_PROVIDER=true
ENABLE_GOOGLE_VISION=false
ENABLE_AWS_REKOGNITION=false

# Feature Deployment
FEATURE_FLAGS_CANARY_ENABLED=false
FEATURE_FLAGS_CANARY_PERCENTAGE=10
