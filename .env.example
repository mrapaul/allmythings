# Environment Configuration Template
# Copy this file to .env and fill in actual values

# Server Configuration
NODE_ENV=development
PORT=8000
API_PORT=8000
API_KEY=

# Detection Service (Grounding DINO)
DETECTION_SERVICE_URL=http://localhost:8001
DETECTION_MODEL_ID=IDEA-Research/grounding-dino-tiny
DETECTION_DEVICE=cpu

# Gemini (primary classifier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro-preview-06-05

# Ollama (fallback classifier)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava:13b
OLLAMA_PORT=11434

# Google Vision (fallback detector)
GOOGLE_PROJECT_ID=
GOOGLE_CREDENTIALS=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# Logging
LOG_LEVEL=info
