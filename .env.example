# Server Configuration
PORT=14000
NODE_ENV=development
API_KEY=

# Detection Service (Florence-2)
DETECTION_SERVICE_URL=http://localhost:14001
FLORENCE_URL=http://localhost:14001

# Detector chain (DETECTOR=vlm path)
# Gemini leads when GEMINI_API_KEY is set; Ollama is the automatic fallback.
# DETECTOR_PRIMARY=ollama flips the order.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DETECTOR_PRIMARY=gemini

# Ollama fallback (gemma4:31b-cloud via Ollama cloud free tier)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_ENABLED=true

# Photo Storage
PHOTO_DIR=~/allmythings-data

# Classification
CLASSIFICATION_TIMEOUT_MS=60000
