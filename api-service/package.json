{
  "name": "api-service",
  "version": "1.0.0",
  "description": "Vision AI API proxy service for Visual Home Inventory Manager",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "prebuild": "npm run test:all && npm run type-check",
    "build": "tsc",
    "build:verified": "npm run verify && npm run build",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cd .. && ./test-e2e-real-image.sh",
    "test:all": "npm run test && npm run lint",
    "verify": "npm run test:all && npm run type-check",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "vision-ai",
    "fastify",
    "ensemble"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.478.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@google-cloud/vision": "^4.1.0",
    "@google/generative-ai": "^0.24.1",
    "fastify": "^4.25.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/form-data": "^2.5.0",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.56.0",
    "form-data": "^4.0.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "testcontainers": "^11.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
