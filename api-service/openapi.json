{
  "openapi": "3.1.0",
  "info": {
    "title": "Visual Home Inventory API",
    "version": "2.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "def-0": {
        "type": "object",
        "required": [
          "label",
          "description",
          "category",
          "tags",
          "box"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "box": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          }
        },
        "title": "DetectedItem"
      }
    }
  },
  "paths": {
    "/v1/detect": {
      "post": {
        "summary": "Detect home objects in 1–3 image frames",
        "tags": [
          "vision"
        ],
        "description": "Query params: `tier` (standard|quality) selects the VLM engine; `mode` (full|scout, default full) selects the detection depth — scout runs pass 1 + adaptive tiles only, skipping the pass-2 audit (cheaper, less exhaustive); `async=1` registers a background run and returns 202. The annotated render of a detection photo is derivable as `${base}/photos/<photoSha256>.jpg?annotated=1` (photoSha256 is in the 202 body and the SSE meta event); it 404s until rendered, so clients fall back to the raw photo.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/def-0"
                      }
                    },
                    "scene": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "estimatedTotalItems": {
                          "type": "number",
                          "nullable": true
                        },
                        "verdict": {
                          "type": "string"
                        },
                        "verdictReason": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "mergeSuggestions": {
                      "type": "array",
                      "description": "Pairs the pipeline suspects are one physical object but did not merge; itemIndexA/itemIndexB index into items. Present the merge to the user rather than applying it.",
                      "items": {
                        "type": "object",
                        "required": [
                          "itemIndexA",
                          "itemIndexB",
                          "reason",
                          "confidence"
                        ],
                        "properties": {
                          "itemIndexA": {
                            "type": "integer"
                          },
                          "itemIndexB": {
                            "type": "integer"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "confidence": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "runId",
                    "statusUrl"
                  ],
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "statusUrl": {
                      "type": "string"
                    },
                    "photoSha256": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/label": {
      "post": {
        "summary": "Suggest a label for a single-object crop",
        "tags": [
          "vision"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "label",
                    "category",
                    "description",
                    "tags"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/vocab/match": {
      "post": {
        "summary": "Rank a vocabulary against a query by embedding similarity",
        "tags": [
          "semantics"
        ],
        "description": "Semantic search helper: returns the vocabulary entries closest in meaning to the query, ranked by cosine similarity. Returns an empty match list (not an error) when the embedding backend is unavailable, so callers can fall back to substring search.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query",
                  "vocabulary"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Free-text search term"
                  },
                  "vocabulary": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Candidate values to rank, e.g. the user's item labels"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25
                  },
                  "minScore": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "matches"
                  ],
                  "properties": {
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "value",
                          "score"
                        ],
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "score": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "degraded": {
                      "type": "boolean",
                      "description": "True when embeddings were unavailable and no ranking was possible"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/precheck": {
      "post": {
        "summary": "Fast capture precheck on a small preview frame",
        "tags": [
          "vision"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "scene",
                    "quality",
                    "objectDensity",
                    "visibleObjectCount",
                    "peoplePresent",
                    "processable",
                    "advice"
                  ],
                  "properties": {
                    "scene": {
                      "type": "string",
                      "enum": [
                        "interior",
                        "exterior",
                        "person_focus",
                        "document",
                        "other"
                      ]
                    },
                    "quality": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "too_dark",
                        "too_blurry",
                        "too_far"
                      ]
                    },
                    "objectDensity": {
                      "type": "string",
                      "enum": [
                        "none",
                        "few",
                        "moderate",
                        "many",
                        "too_many"
                      ]
                    },
                    "visibleObjectCount": {
                      "type": "integer",
                      "nullable": true
                    },
                    "peoplePresent": {
                      "type": "boolean"
                    },
                    "processable": {
                      "type": "boolean"
                    },
                    "advice": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/corrections": {
      "post": {
        "summary": "Record user corrections as training-data flywheel samples",
        "tags": [
          "flywheel"
        ],
        "responses": {
          "204": {
            "description": "Recorded"
          }
        }
      }
    },
    "/v1/detect/stream": {
      "post": {
        "summary": "Detect home objects, streaming items via SSE",
        "tags": [
          "vision"
        ],
        "description": "SSE event types: `meta` (runId/traceId), `scene` (pass-1 assessment), `item` (one DetectedItem), `merge-suggestion` ({itemIndexA, itemIndexB, reason, confidence} indexing the emitted item sequence — a pair the pipeline suspects is one object but did not merge), `error`, `done`. Query params: `tier` (standard|quality) selects the VLM engine; `mode` (full|scout, default full) — scout runs pass 1 + adaptive tiles only, skipping the pass-2 audit. The annotated render of the frame is derivable as `${base}/photos/<photoSha256>.jpg?annotated=1` (photoSha256 is in the meta event); it 404s until rendered, so clients fall back to the raw photo.",
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "description": "SSE stream",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/detect/status/{workflowId}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workflowId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/photos/{filename}": {
      "get": {
        "summary": "Serve a persisted detection photo",
        "tags": [
          "vision"
        ],
        "description": "Returns the raw photo by default. With `annotated=1`, returns the annotated render of a detection photo (every returned DetectedItem box + label burned in). The annotated URL is derived from photoSha256 — returned by POST /v1/detect?async=1 and the SSE meta event — as `${base}/photos/<photoSha256>.jpg?annotated=1`; it is rendered asynchronously after a successful detection and 404s until ready (fall back to the raw photo).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "annotated",
            "required": false,
            "description": "Pass '1' for the annotated render; absent serves the raw photo."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "filename",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "image bytes",
            "content": {
              "application/json": {
                "schema": {
                  "description": "image bytes",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ]
}