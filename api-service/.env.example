# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visual_inventory
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_SIZE=20

# S3 / Storage Configuration
S3_BASE_URL=https://storage.example.com
S3_BUCKET=inventory-photos
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY used for S3 if set

# Google Cloud Vision
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# AWS Rekognition (optional)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Ensemble Configuration
ENSEMBLE_CONFIDENCE_THRESHOLD=0.7
PROVIDER_TIMEOUT_MS=4000
NMS_IOU_THRESHOLD=0.5

# Provider Weights (must sum to ~1.0)
META_WEIGHT=0.30
GOOGLE_WEIGHT=0.30
AWS_WEIGHT=0.25
TENSORFLOW_WEIGHT=0.15
