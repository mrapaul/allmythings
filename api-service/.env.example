# Server Configuration
PORT=14000
NODE_ENV=development
API_KEY=

# Detection Service (Grounding DINO)
DETECTION_SERVICE_URL=http://localhost:14001

# Gemini (primary classifier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (fallback classifier)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_ENABLED=true

# Text embeddings (Ollama /api/embed) — same-kind label matching during dedupe
# and POST /v1/vocab/match. Fail-open: if this is down, dedupe degrades to
# exact/token label matching and /v1/vocab/match returns {matches: [], degraded: true}.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_CACHE_SIZE=4000

# Fallback judge for items the detector model left without an is_possession
# flag. Text-only call on OLLAMA_MODEL, cached per distinct label. Fail-open:
# an unjudged item is kept, never silently dropped.
POSSESSION_JUDGE_ENABLED=true
POSSESSION_JUDGE_TIMEOUT_MS=20000

# Capture precheck (POST /v1/precheck) — its OWN small model, never the big
# detector. Apache-2.0 only: qwen3-vl 2b/4b/8b are Apache-2.0, the qwen2.5vl:*
# tags are Qwen Research License and must not ship. Measured on a fresh frame
# with the model resident: 4b-instruct 3.0s, 2b-instruct 1.8s (2B echoes the
# enum, e.g. "interior|room", which the parser now normalizes).
PRECHECK_MODEL=qwen3-vl:4b-instruct
PRECHECK_MAX_OBJECTS=35
PRECHECK_TIMEOUT_MS=6000
PRECHECK_MAX_DIMENSION=384
PRECHECK_KEEP_ALIVE=30m
# Detection model residency. Ollama's default (5m) evicts the 20 GB detector
# between shots; reloading costs ~2 min per photo. Both models are warmed at boot.
VLM_KEEP_ALIVE=1h


# Observability (HyperDX OTLP)
OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=api-service
OTEL_SERVICE_VERSION=2.0.0
