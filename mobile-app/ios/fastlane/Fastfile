default_platform(:ios)

platform :ios do
  desc "Runs all the tests"
  lane :test do
    Dir.chdir("../..") do
      sh("flutter test")
    end
  end

  desc "Build a development IPA for local testing"
  lane :build_dev do
    Dir.chdir("../..") do
      sh("flutter build ipa --release --export-method=development")
    end
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Build the IPA using Flutter CLI (more robust for Flutter apps)
    Dir.chdir("../..") do
      sh("flutter build ipa --release --export-method=app-store")
    end
    
    # 2. Upload the generated IPA to TestFlight
    # If the file exists, we proceed.
    ipa_path = "../../build/ios/ipa/allmythings.ipa"
    if File.exist?(ipa_path)
      upload_to_testflight(ipa: ipa_path, skip_waiting_for_build_processing: true)
    else
      alt_path = "../../build/ios/ipa/Runner.ipa"
      if File.exist?(alt_path)
        upload_to_testflight(ipa: alt_path, skip_waiting_for_build_processing: true)
      else
        UI.user_error!("Could not find IPA. Ensure your App Store Provisioning Profiles and Certificates are correctly set up in Xcode.")
      end
    end
  end
end
