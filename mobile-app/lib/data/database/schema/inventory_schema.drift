-- ============================================================================
-- Visual Home Inventory Manager - Mobile Database Schema (Drift)
-- ============================================================================
-- Optimized for offline-first operation with sync capabilities
-- Supports full-text search, hierarchical data, and complex querying

-- ============================================================================
-- CORE ENTITIES
-- ============================================================================

-- Users table (cached from backend)
CREATE TABLE users (
  id TEXT PRIMARY KEY NOT NULL,
  email TEXT NOT NULL UNIQUE,
  display_name TEXT,
  avatar_url TEXT,
  created_at INTEGER NOT NULL, -- Unix timestamp
  updated_at INTEGER NOT NULL,
  last_synced_at INTEGER
) AS UserEntity;

-- Inventory items - core entity for tracked objects
CREATE TABLE inventory_items (
  id TEXT PRIMARY KEY NOT NULL,
  user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,

  -- User-customizable fields
  title TEXT NOT NULL,
  description TEXT,
  notes TEXT,

  -- Classification
  primary_label_id TEXT REFERENCES labels(id) ON DELETE SET NULL,
  location_id TEXT REFERENCES locations(id) ON DELETE SET NULL,

  -- Metadata
  quantity INTEGER NOT NULL DEFAULT 1,
  estimated_value_cents INTEGER, -- Store monetary values as cents
  purchase_date INTEGER, -- Unix timestamp
  warranty_expiry_date INTEGER,

  -- Detection tracking
  detection_session_id TEXT REFERENCES detection_sessions(id) ON DELETE SET NULL,
  primary_image_id TEXT REFERENCES item_images(id) ON DELETE SET NULL,

  -- Audit fields
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER, -- Soft delete for sync

  -- Sync tracking
  synced_at INTEGER,
  sync_status TEXT NOT NULL DEFAULT 'pending' CHECK(sync_status IN ('pending', 'synced', 'conflict', 'error')),
  version INTEGER NOT NULL DEFAULT 1 -- Optimistic locking
) AS InventoryItemEntity;

-- Labels - hierarchical object classification taxonomy
CREATE TABLE labels (
  id TEXT PRIMARY KEY NOT NULL,

  -- Label information
  name TEXT NOT NULL,
  normalized_name TEXT NOT NULL, -- Lowercase, no special chars for matching
  parent_label_id TEXT REFERENCES labels(id) ON DELETE SET NULL,
  level INTEGER NOT NULL DEFAULT 0, -- 0=root, 1=category, 2=subcategory, etc.
  path TEXT NOT NULL, -- Materialized path: "/furniture/seating/chair"

  -- Classification
  label_type TEXT NOT NULL DEFAULT 'ai' CHECK(label_type IN ('ai', 'user', 'system')),
  category TEXT, -- Top-level category (furniture, electronics, etc.)

  -- Metadata
  icon TEXT, -- Icon identifier or emoji
  color TEXT, -- Hex color for UI
  usage_count INTEGER NOT NULL DEFAULT 0, -- Denormalized for popularity

  -- AI provider tracking
  ai_provider TEXT, -- Which provider generated this label
  confidence_score REAL, -- Average confidence when AI-generated

  -- Audit
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,

  -- Sync
  synced_at INTEGER,

  UNIQUE(normalized_name, parent_label_id)
) AS LabelEntity;

-- Full-text search for labels
CREATE VIRTUAL TABLE label_search_fts USING fts5(
  label_id UNINDEXED,
  name,
  normalized_name,
  path,
  category,
  content=labels,
  content_rowid=rowid
);

-- Tags - user-defined flexible categorization
CREATE TABLE tags (
  id TEXT PRIMARY KEY NOT NULL,
  user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,

  name TEXT NOT NULL,
  normalized_name TEXT NOT NULL,
  color TEXT, -- Hex color
  icon TEXT,

  usage_count INTEGER NOT NULL DEFAULT 0,

  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,

  synced_at INTEGER,

  UNIQUE(user_id, normalized_name)
) AS TagEntity;

-- Locations - hierarchical location structure
CREATE TABLE locations (
  id TEXT PRIMARY KEY NOT NULL,
  user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,

  name TEXT NOT NULL,
  parent_location_id TEXT REFERENCES locations(id) ON DELETE CASCADE,
  level INTEGER NOT NULL DEFAULT 0, -- 0=home, 1=floor, 2=room, 3=area
  path TEXT NOT NULL, -- Materialized path: "/home/first-floor/bedroom"

  location_type TEXT CHECK(location_type IN ('home', 'floor', 'room', 'area', 'storage', 'outdoor')),

  -- Metadata
  description TEXT,
  icon TEXT,
  image_url TEXT,

  -- Statistics (denormalized)
  item_count INTEGER NOT NULL DEFAULT 0,

  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,

  synced_at INTEGER,

  UNIQUE(user_id, path)
) AS LocationEntity;

-- ============================================================================
-- RELATIONSHIP TABLES (Many-to-Many)
-- ============================================================================

-- Item to Label mapping (many-to-many)
CREATE TABLE item_labels (
  id TEXT PRIMARY KEY NOT NULL,
  item_id TEXT NOT NULL REFERENCES inventory_items(id) ON DELETE CASCADE,
  label_id TEXT NOT NULL REFERENCES labels(id) ON DELETE CASCADE,

  -- Tracking
  source TEXT NOT NULL CHECK(source IN ('ai_detected', 'user_added', 'user_edited')),
  confidence_score REAL, -- Only for AI-detected labels
  detection_result_id TEXT REFERENCES detection_results(id) ON DELETE SET NULL,

  is_primary BOOLEAN NOT NULL DEFAULT 0, -- Only one primary label per item

  created_at INTEGER NOT NULL,

  synced_at INTEGER,

  UNIQUE(item_id, label_id)
) AS ItemLabelEntity;

-- Item to Tag mapping (many-to-many)
CREATE TABLE item_tags (
  id TEXT PRIMARY KEY NOT NULL,
  item_id TEXT NOT NULL REFERENCES inventory_items(id) ON DELETE CASCADE,
  tag_id TEXT NOT NULL REFERENCES tags(id) ON DELETE CASCADE,

  created_at INTEGER NOT NULL,

  synced_at INTEGER,

  UNIQUE(item_id, tag_id)
) AS ItemTagEntity;

-- ============================================================================
-- DETECTION & AI PROCESSING
-- ============================================================================

-- Detection sessions - tracks each API call to vision providers
CREATE TABLE detection_sessions (
  id TEXT PRIMARY KEY NOT NULL,
  user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,

  -- Request metadata
  image_id TEXT NOT NULL REFERENCES item_images(id) ON DELETE CASCADE,
  requested_at INTEGER NOT NULL,
  completed_at INTEGER,

  -- Provider configuration
  providers_used TEXT NOT NULL, -- JSON array: ["google_vision", "aws_rekognition"]
  fusion_strategy TEXT NOT NULL DEFAULT 'weighted_confidence' CHECK(
    fusion_strategy IN ('weighted_confidence', 'unanimous', 'majority_vote', 'highest_confidence')
  ),

  -- Results
  status TEXT NOT NULL DEFAULT 'pending' CHECK(
    status IN ('pending', 'processing', 'completed', 'failed', 'partial')
  ),
  error_message TEXT,

  -- Ensemble metrics
  total_detections INTEGER NOT NULL DEFAULT 0,
  avg_confidence REAL,
  provider_agreement_score REAL, -- 0-1, how much providers agreed
  processing_time_ms INTEGER,

  -- Metadata
  api_version TEXT,
  client_version TEXT,

  created_at INTEGER NOT NULL,

  synced_at INTEGER
) AS DetectionSessionEntity;

-- Detection results - individual provider responses
CREATE TABLE detection_results (
  id TEXT PRIMARY KEY NOT NULL,
  detection_session_id TEXT NOT NULL REFERENCES detection_sessions(id) ON DELETE CASCADE,

  -- Provider info
  provider TEXT NOT NULL CHECK(provider IN ('google_vision', 'aws_rekognition', 'azure_cv', 'mock')),
  provider_request_id TEXT, -- External tracking ID

  -- Detection data
  detected_label TEXT NOT NULL, -- Raw label from provider
  normalized_label TEXT NOT NULL, -- Normalized for matching
  confidence_score REAL NOT NULL CHECK(confidence_score >= 0 AND confidence_score <= 1),

  -- Spatial information
  has_bounding_box BOOLEAN NOT NULL DEFAULT 0,

  -- Additional provider metadata
  provider_metadata TEXT, -- JSON blob for provider-specific data
  locale TEXT, -- Language/locale of detection

  -- Result quality
  is_selected BOOLEAN NOT NULL DEFAULT 0, -- Whether this was chosen in ensemble fusion
  fusion_weight REAL, -- Weight given in ensemble fusion

  created_at INTEGER NOT NULL,

  synced_at INTEGER
) AS DetectionResultEntity;

-- Bounding boxes - spatial coordinates for detected objects
CREATE TABLE bounding_boxes (
  id TEXT PRIMARY KEY NOT NULL,
  detection_result_id TEXT NOT NULL REFERENCES detection_results(id) ON DELETE CASCADE,

  -- Normalized coordinates (0-1 range relative to image dimensions)
  x_min REAL NOT NULL CHECK(x_min >= 0 AND x_min <= 1),
  y_min REAL NOT NULL CHECK(y_min >= 0 AND y_min <= 1),
  x_max REAL NOT NULL CHECK(x_max >= 0 AND x_max <= 1),
  y_max REAL NOT NULL CHECK(y_max >= 0 AND y_max <= 1),

  -- Calculated dimensions
  width REAL NOT NULL CHECK(width >= 0 AND width <= 1),
  height REAL NOT NULL CHECK(height >= 0 AND height <= 1),
  area REAL NOT NULL CHECK(area >= 0 AND area <= 1),

  -- Confidence in bounding box accuracy
  confidence REAL,

  created_at INTEGER NOT NULL
) AS BoundingBoxEntity;

-- ============================================================================
-- IMAGES & MEDIA
-- ============================================================================

-- Item images - photos of inventory items
CREATE TABLE item_images (
  id TEXT PRIMARY KEY NOT NULL,
  item_id TEXT REFERENCES inventory_items(id) ON DELETE CASCADE,

  -- File information
  local_path TEXT NOT NULL, -- Local file path on device
  remote_url TEXT, -- Cloud storage URL after sync
  thumbnail_path TEXT,
  thumbnail_url TEXT,

  -- Image properties
  width INTEGER,
  height INTEGER,
  file_size_bytes INTEGER,
  mime_type TEXT NOT NULL DEFAULT 'image/jpeg',

  -- Metadata
  captured_at INTEGER NOT NULL,
  is_primary BOOLEAN NOT NULL DEFAULT 0,
  display_order INTEGER NOT NULL DEFAULT 0,

  -- Upload tracking
  upload_status TEXT NOT NULL DEFAULT 'pending' CHECK(
    upload_status IN ('pending', 'uploading', 'uploaded', 'failed')
  ),
  upload_progress REAL, -- 0-1

  created_at INTEGER NOT NULL,
  deleted_at INTEGER,

  synced_at INTEGER
) AS ItemImageEntity;

-- Image metadata - EXIF and technical details
CREATE TABLE image_metadata (
  id TEXT PRIMARY KEY NOT NULL,
  image_id TEXT NOT NULL UNIQUE REFERENCES item_images(id) ON DELETE CASCADE,

  -- EXIF data
  camera_make TEXT,
  camera_model TEXT,
  focal_length REAL,
  aperture REAL,
  iso INTEGER,
  exposure_time TEXT,
  flash_used BOOLEAN,

  -- Location (from EXIF GPS)
  gps_latitude REAL,
  gps_longitude REAL,
  gps_altitude REAL,

  -- Orientation
  orientation INTEGER, -- EXIF orientation value

  -- Additional metadata (JSON)
  raw_exif_data TEXT, -- Full EXIF as JSON

  created_at INTEGER NOT NULL
) AS ImageMetadataEntity;

-- ============================================================================
-- SYNCHRONIZATION & OFFLINE SUPPORT
-- ============================================================================

-- Sync queue - tracks pending changes for offline-first sync
CREATE TABLE sync_queue (
  id TEXT PRIMARY KEY NOT NULL,

  -- Change tracking
  entity_type TEXT NOT NULL CHECK(
    entity_type IN ('inventory_item', 'label', 'tag', 'location', 'item_image',
                    'item_label', 'item_tag', 'detection_session')
  ),
  entity_id TEXT NOT NULL,
  operation TEXT NOT NULL CHECK(operation IN ('create', 'update', 'delete')),

  -- Change data
  payload TEXT NOT NULL, -- JSON snapshot of entity data

  -- Sync status
  status TEXT NOT NULL DEFAULT 'pending' CHECK(
    status IN ('pending', 'syncing', 'completed', 'failed', 'conflict')
  ),
  retry_count INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,

  -- Priority and ordering
  priority INTEGER NOT NULL DEFAULT 0, -- Higher priority syncs first
  sequence_number INTEGER NOT NULL, -- Ensures ordered sync
  depends_on_id TEXT REFERENCES sync_queue(id), -- Dependency chain

  -- Timestamps
  created_at INTEGER NOT NULL,
  scheduled_at INTEGER, -- When to attempt sync
  synced_at INTEGER
) AS SyncQueueEntity;

-- Sync conflicts - tracks conflicts detected during sync
CREATE TABLE sync_conflicts (
  id TEXT PRIMARY KEY NOT NULL,

  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,

  -- Conflict data
  local_version TEXT NOT NULL, -- JSON of local state
  remote_version TEXT NOT NULL, -- JSON of remote state
  local_timestamp INTEGER NOT NULL,
  remote_timestamp INTEGER NOT NULL,

  -- Resolution
  resolution_strategy TEXT CHECK(
    resolution_strategy IN ('use_local', 'use_remote', 'merge', 'manual')
  ),
  resolved_at INTEGER,
  resolved_version TEXT, -- JSON of resolved state

  created_at INTEGER NOT NULL
) AS SyncConflictEntity;

-- ============================================================================
-- SEARCH & INDEXING
-- ============================================================================

-- Full-text search for inventory items
CREATE VIRTUAL TABLE item_search_fts USING fts5(
  item_id UNINDEXED,
  title,
  description,
  notes,
  labels, -- Concatenated label names
  tags, -- Concatenated tag names
  location_path,
  content=inventory_items,
  tokenize='porter unicode61'
);

-- ============================================================================
-- ANALYTICS & USAGE TRACKING
-- ============================================================================

-- Search history - for autocomplete and analytics
CREATE TABLE search_history (
  id TEXT PRIMARY KEY NOT NULL,
  user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,

  query TEXT NOT NULL,
  normalized_query TEXT NOT NULL,

  -- Results
  result_count INTEGER NOT NULL DEFAULT 0,
  clicked_item_id TEXT REFERENCES inventory_items(id) ON DELETE SET NULL,

  -- Metadata
  search_type TEXT NOT NULL CHECK(search_type IN ('text', 'label', 'tag', 'location', 'advanced')),
  filters_used TEXT, -- JSON of applied filters

  created_at INTEGER NOT NULL
) AS SearchHistoryEntity;

-- User preferences and settings
CREATE TABLE user_preferences (
  id TEXT PRIMARY KEY NOT NULL,
  user_id TEXT NOT NULL UNIQUE REFERENCES users(id) ON DELETE CASCADE,

  -- Display preferences
  theme TEXT NOT NULL DEFAULT 'system' CHECK(theme IN ('light', 'dark', 'system')),
  default_view TEXT NOT NULL DEFAULT 'grid' CHECK(default_view IN ('grid', 'list', 'gallery')),
  items_per_page INTEGER NOT NULL DEFAULT 20,

  -- Feature preferences
  auto_detect_enabled BOOLEAN NOT NULL DEFAULT 1,
  preferred_providers TEXT, -- JSON array of preferred vision providers
  min_confidence_threshold REAL NOT NULL DEFAULT 0.5,

  -- Privacy
  enable_gps_tagging BOOLEAN NOT NULL DEFAULT 0,
  share_analytics BOOLEAN NOT NULL DEFAULT 1,

  -- Sync preferences
  sync_on_wifi_only BOOLEAN NOT NULL DEFAULT 1,
  auto_backup_enabled BOOLEAN NOT NULL DEFAULT 1,

  -- Preferences JSON blob for extensibility
  additional_settings TEXT,

  updated_at INTEGER NOT NULL
) AS UserPreferencesEntity;

-- ============================================================================
-- INDEXES FOR PERFORMANCE
-- ============================================================================

-- Inventory items indexes
CREATE INDEX idx_inventory_items_user_id ON inventory_items(user_id);
CREATE INDEX idx_inventory_items_location_id ON inventory_items(location_id);
CREATE INDEX idx_inventory_items_primary_label_id ON inventory_items(primary_label_id);
CREATE INDEX idx_inventory_items_created_at ON inventory_items(created_at DESC);
CREATE INDEX idx_inventory_items_sync_status ON inventory_items(sync_status)
  WHERE sync_status != 'synced';
CREATE INDEX idx_inventory_items_deleted_at ON inventory_items(deleted_at)
  WHERE deleted_at IS NOT NULL;

-- Labels indexes
CREATE INDEX idx_labels_parent_id ON labels(parent_label_id);
CREATE INDEX idx_labels_normalized_name ON labels(normalized_name);
CREATE INDEX idx_labels_path ON labels(path);
CREATE INDEX idx_labels_usage_count ON labels(usage_count DESC);
CREATE INDEX idx_labels_type_category ON labels(label_type, category);

-- Tags indexes
CREATE INDEX idx_tags_user_id ON tags(user_id);
CREATE INDEX idx_tags_normalized_name ON tags(user_id, normalized_name);
CREATE INDEX idx_tags_usage_count ON tags(usage_count DESC);

-- Locations indexes
CREATE INDEX idx_locations_user_id ON locations(user_id);
CREATE INDEX idx_locations_parent_id ON locations(parent_location_id);
CREATE INDEX idx_locations_path ON locations(path);

-- Item labels indexes
CREATE INDEX idx_item_labels_item_id ON item_labels(item_id);
CREATE INDEX idx_item_labels_label_id ON item_labels(label_id);
CREATE INDEX idx_item_labels_primary ON item_labels(item_id, is_primary)
  WHERE is_primary = 1;

-- Item tags indexes
CREATE INDEX idx_item_tags_item_id ON item_tags(item_id);
CREATE INDEX idx_item_tags_tag_id ON item_tags(tag_id);

-- Detection sessions indexes
CREATE INDEX idx_detection_sessions_user_id ON detection_sessions(user_id);
CREATE INDEX idx_detection_sessions_image_id ON detection_sessions(image_id);
CREATE INDEX idx_detection_sessions_status ON detection_sessions(status);
CREATE INDEX idx_detection_sessions_created_at ON detection_sessions(created_at DESC);

-- Detection results indexes
CREATE INDEX idx_detection_results_session_id ON detection_results(detection_session_id);
CREATE INDEX idx_detection_results_provider ON detection_results(provider);
CREATE INDEX idx_detection_results_confidence ON detection_results(confidence_score DESC);
CREATE INDEX idx_detection_results_selected ON detection_results(is_selected)
  WHERE is_selected = 1;

-- Item images indexes
CREATE INDEX idx_item_images_item_id ON item_images(item_id);
CREATE INDEX idx_item_images_primary ON item_images(item_id, is_primary)
  WHERE is_primary = 1;
CREATE INDEX idx_item_images_upload_status ON item_images(upload_status)
  WHERE upload_status != 'uploaded';

-- Sync queue indexes
CREATE INDEX idx_sync_queue_status ON sync_queue(status, priority DESC, sequence_number);
CREATE INDEX idx_sync_queue_entity ON sync_queue(entity_type, entity_id);
CREATE INDEX idx_sync_queue_scheduled ON sync_queue(scheduled_at)
  WHERE status = 'pending';

-- Search history indexes
CREATE INDEX idx_search_history_user_id ON search_history(user_id, created_at DESC);
CREATE INDEX idx_search_history_query ON search_history(normalized_query);

-- ============================================================================
-- TRIGGERS FOR DATA INTEGRITY & DENORMALIZATION
-- ============================================================================

-- Update usage_count on labels when item_labels changes
CREATE TRIGGER update_label_usage_on_insert
AFTER INSERT ON item_labels
BEGIN
  UPDATE labels
  SET usage_count = usage_count + 1, updated_at = unixepoch()
  WHERE id = NEW.label_id;
END;

CREATE TRIGGER update_label_usage_on_delete
AFTER DELETE ON item_labels
BEGIN
  UPDATE labels
  SET usage_count = usage_count - 1, updated_at = unixepoch()
  WHERE id = OLD.label_id;
END;

-- Update usage_count on tags when item_tags changes
CREATE TRIGGER update_tag_usage_on_insert
AFTER INSERT ON item_tags
BEGIN
  UPDATE tags
  SET usage_count = usage_count + 1, updated_at = unixepoch()
  WHERE id = NEW.tag_id;
END;

CREATE TRIGGER update_tag_usage_on_delete
AFTER DELETE ON item_tags
BEGIN
  UPDATE tags
  SET usage_count = usage_count - 1, updated_at = unixepoch()
  WHERE id = OLD.tag_id;
END;

-- Update location item_count when inventory items change location
CREATE TRIGGER update_location_count_on_insert
AFTER INSERT ON inventory_items
WHEN NEW.location_id IS NOT NULL
BEGIN
  UPDATE locations
  SET item_count = item_count + 1, updated_at = unixepoch()
  WHERE id = NEW.location_id;
END;

CREATE TRIGGER update_location_count_on_update
AFTER UPDATE OF location_id ON inventory_items
BEGIN
  -- Decrement old location
  UPDATE locations
  SET item_count = item_count - 1, updated_at = unixepoch()
  WHERE id = OLD.location_id AND OLD.location_id IS NOT NULL;

  -- Increment new location
  UPDATE locations
  SET item_count = item_count + 1, updated_at = unixepoch()
  WHERE id = NEW.location_id AND NEW.location_id IS NOT NULL;
END;

CREATE TRIGGER update_location_count_on_delete
AFTER DELETE ON inventory_items
WHEN OLD.location_id IS NOT NULL
BEGIN
  UPDATE locations
  SET item_count = item_count - 1, updated_at = unixepoch()
  WHERE id = OLD.location_id;
END;

-- Auto-update updated_at timestamps
CREATE TRIGGER update_inventory_items_timestamp
AFTER UPDATE ON inventory_items
FOR EACH ROW
BEGIN
  UPDATE inventory_items SET updated_at = unixepoch() WHERE id = NEW.id;
END;

CREATE TRIGGER update_labels_timestamp
AFTER UPDATE ON labels
FOR EACH ROW
BEGIN
  UPDATE labels SET updated_at = unixepoch() WHERE id = NEW.id;
END;

CREATE TRIGGER update_tags_timestamp
AFTER UPDATE ON tags
FOR EACH ROW
BEGIN
  UPDATE tags SET updated_at = unixepoch() WHERE id = NEW.id;
END;

CREATE TRIGGER update_locations_timestamp
AFTER UPDATE ON locations
FOR EACH ROW
BEGIN
  UPDATE locations SET updated_at = unixepoch() WHERE id = NEW.id;
END;

-- Maintain FTS index for labels
CREATE TRIGGER label_search_fts_insert AFTER INSERT ON labels
BEGIN
  INSERT INTO label_search_fts(rowid, label_id, name, normalized_name, path, category)
  VALUES (NEW.rowid, NEW.id, NEW.name, NEW.normalized_name, NEW.path, NEW.category);
END;

CREATE TRIGGER label_search_fts_delete AFTER DELETE ON labels
BEGIN
  DELETE FROM label_search_fts WHERE rowid = OLD.rowid;
END;

CREATE TRIGGER label_search_fts_update AFTER UPDATE ON labels
BEGIN
  UPDATE label_search_fts
  SET name = NEW.name,
      normalized_name = NEW.normalized_name,
      path = NEW.path,
      category = NEW.category
  WHERE rowid = NEW.rowid;
END;

-- Add to sync queue on data changes (for entities that need sync)
CREATE TRIGGER sync_queue_inventory_item_insert
AFTER INSERT ON inventory_items
BEGIN
  INSERT INTO sync_queue(id, entity_type, entity_id, operation, payload, sequence_number, created_at)
  VALUES (
    hex(randomblob(16)),
    'inventory_item',
    NEW.id,
    'create',
    json_object(
      'id', NEW.id,
      'user_id', NEW.user_id,
      'title', NEW.title,
      'description', NEW.description
      -- Add other fields as needed
    ),
    (SELECT COALESCE(MAX(sequence_number), 0) + 1 FROM sync_queue),
    unixepoch()
  );
END;

CREATE TRIGGER sync_queue_inventory_item_update
AFTER UPDATE ON inventory_items
WHEN NEW.updated_at > OLD.updated_at
BEGIN
  INSERT INTO sync_queue(id, entity_type, entity_id, operation, payload, sequence_number, created_at)
  VALUES (
    hex(randomblob(16)),
    'inventory_item',
    NEW.id,
    'update',
    json_object(
      'id', NEW.id,
      'user_id', NEW.user_id,
      'title', NEW.title,
      'description', NEW.description,
      'version', NEW.version
    ),
    (SELECT COALESCE(MAX(sequence_number), 0) + 1 FROM sync_queue),
    unixepoch()
  );
END;

-- Soft delete trigger to mark items for deletion sync
CREATE TRIGGER sync_queue_inventory_item_soft_delete
AFTER UPDATE OF deleted_at ON inventory_items
WHEN NEW.deleted_at IS NOT NULL AND OLD.deleted_at IS NULL
BEGIN
  INSERT INTO sync_queue(id, entity_type, entity_id, operation, payload, sequence_number, created_at)
  VALUES (
    hex(randomblob(16)),
    'inventory_item',
    NEW.id,
    'delete',
    json_object('id', NEW.id, 'deleted_at', NEW.deleted_at),
    (SELECT COALESCE(MAX(sequence_number), 0) + 1 FROM sync_queue),
    unixepoch()
  );
END;
