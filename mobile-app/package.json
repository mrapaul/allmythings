    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-trace-web": "^1.30.0",
    "@sentry/react-native": "^7.2.0",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/react-query": "^5.62.0",
    "consola": "^3.4.0",
    "drizzle-orm": "^0.36.0",
