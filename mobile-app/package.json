    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "ofetch": "^1.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
