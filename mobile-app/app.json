{
  "expo": {
    "name": "Home Inventory",
    "slug": "home-inventory",
    "scheme": "homeinventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codesparktech.homeinventory",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Home Inventory uses the camera to photograph shelves, drawers, and rooms so their contents can be detected and added to your inventory.",
        "NSPhotoLibraryUsageDescription": "Home Inventory reads photos you choose so their contents can be detected and added to your inventory.",
        "NSPhotoLibraryAddUsageDescription": "Home Inventory can save processed photos of your items back to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.codesparktech.homeinventory",
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"]
    },
    "plugins": ["expo-router", "expo-font", "expo-sqlite", "@sentry/react-native"],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/PROJECT_ID_PLACEHOLDER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiBaseUrl": "$API_BASE_URL",
      "apiKey": "$API_KEY",
      "sentryDsn": "$SENTRY_DSN",
      "otelCollectorUrl": "$OTEL_COLLECTOR_URL"
    },
    "icon": "./assets/images/app_icon.png"
  }
}
