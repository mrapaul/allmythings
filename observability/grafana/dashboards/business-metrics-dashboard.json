{
  "dashboard": {
    "title": "Visual Inventory - Business Metrics",
    "description": "Business metrics including detections, user activity, and sync operations",
    "tags": ["visual-inventory", "business", "metrics"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "5m",
    "panels": [
      {
        "id": 1,
        "title": "Total Detections",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(detections_total[24h]))",
            "legendFormat": "Detections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 100, "color": "green" },
                { "value": 1000, "color": "yellow" }
              ]
            }
          }
        },
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
      },
      {
        "id": 2,
        "title": "Objects Detected",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(objects_detected_total[24h]))",
            "legendFormat": "Objects"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 500, "color": "green" },
                { "value": 5000, "color": "yellow" }
              ]
            }
          }
        },
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
      },
      {
        "id": 3,
        "title": "Items Created",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(items_created_total[24h]))",
            "legendFormat": "Items"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 50, "color": "green" },
                { "value": 500, "color": "yellow" }
              ]
            }
          }
        },
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
      },
      {
        "id": 4,
        "title": "Search Queries",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(search_queries_total[24h]))",
            "legendFormat": "Searches"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 100, "color": "green" },
                { "value": 1000, "color": "yellow" }
              ]
            }
          }
        },
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }
      },
      {
        "id": 5,
        "title": "Detection Rate Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(detections_total[5m])",
            "legendFormat": "Detections/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
      },
      {
        "id": 6,
        "title": "User Sync Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(user_sync_total[5m])) by (operation)",
            "legendFormat": "{{operation}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        },
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
      },
      {
        "id": 7,
        "title": "Detection Confidence Distribution",
        "type": "histogram",
        "targets": [
          {
            "expr": "sum(rate(detection_confidence_bucket[5m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}"
          }
        ],
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 }
      },
      {
        "id": 8,
        "title": "Average Objects Per Detection",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(objects_detected_total[5m])) / sum(rate(detections_total[5m]))",
            "legendFormat": "Avg Objects"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 1, "color": "yellow" },
                { "value": 3, "color": "green" }
              ]
            }
          }
        },
        "gridPos": { "x": 12, "y": 12, "w": 6, "h": 8 }
      },
      {
        "id": 9,
        "title": "Vision Provider Usage Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (provider) (increase(vision_provider_requests_total[24h]))",
            "legendFormat": "{{provider}}"
          }
        ],
        "gridPos": { "x": 18, "y": 12, "w": 6, "h": 8 }
      },
      {
        "id": 10,
        "title": "Sync Success Rate (%)",
        "type": "gauge",
        "targets": [
          {
            "expr": "(sum(rate(user_sync_total{status=\"success\"}[5m])) / sum(rate(user_sync_total[5m]))) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 95, "color": "yellow" },
                { "value": 99, "color": "green" }
              ]
            }
          }
        },
        "gridPos": { "x": 0, "y": 20, "w": 8, "h": 6 }
      },
      {
        "id": 11,
        "title": "Detection Success by Provider",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(vision_provider_requests_total{status=\"success\"}[5m])) by (provider)",
            "legendFormat": "{{provider}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": { "x": 8, "y": 20, "w": 16, "h": 6 }
      },
      {
        "id": 12,
        "title": "Top Search Terms",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum(rate(search_queries_total[24h])) by (query_term))",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 }
      },
      {
        "id": 13,
        "title": "Items Created Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(items_created_total[5m])",
            "legendFormat": "Items/sec"
          }
        ],
        "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 }
      },
      {
        "id": 14,
        "title": "Hourly Detection Volume",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(increase(detections_total[1h]))",
            "legendFormat": "Detections per hour"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": { "x": 0, "y": 34, "w": 12, "h": 8 }
      },
      {
        "id": 15,
        "title": "Image Processing Volume (bytes/sec)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(image_upload_size_bytes_sum[5m])",
            "legendFormat": "Upload Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          }
        },
        "gridPos": { "x": 12, "y": 34, "w": 12, "h": 8 }
      }
    ]
  }
}
